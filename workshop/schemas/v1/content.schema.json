{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-kaguya.invalid/schemas/workshop/v1/content.schema.json",
  "title": "Super Kaguya declarative content v1",
  "oneOf": [
    { "$ref": "#/$defs/itemPackage" },
    { "$ref": "#/$defs/mechanicPackage" },
    { "$ref": "#/$defs/assetPackage" },
    { "$ref": "#/$defs/assetDescriptorPackage" },
    { "$ref": "#/$defs/musicPackage" },
    { "$ref": "#/$defs/mapPackage" },
    { "$ref": "#/$defs/componentLibrary" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "minLength": 3, "maxLength": 64 },
    "editor": { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 48 }, "category": { "type": "string", "maxLength": 32 }, "help": { "type": "string", "maxLength": 240 } } },
    "filter": { "type": "object", "additionalProperties": false, "properties": { "definition": { "type": "string", "minLength": 3, "maxLength": 160 }, "entityKind": { "enum": ["enemy", "boss"] }, "objectId": { "type": "integer", "minimum": 1 }, "regionId": { "type": "integer", "minimum": 1 } } },
    "action": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "addScore" }, "amount": { "type": "number", "minimum": -999999, "maximum": 999999 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "enum": ["heal", "damagePlayer"] }, "amount": { "type": "number", "minimum": 0, "maximum": 999999 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "power"], "properties": { "type": { "const": "grantPower" }, "power": { "enum": ["big", "fire", "star"] }, "duration": { "type": "number", "minimum": 0.1, "maximum": 60 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "track"], "properties": { "type": { "const": "playAudio" }, "track": { "type": "string", "minLength": 3, "maxLength": 160 }, "gain": { "type": "number", "minimum": 0, "maximum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "counter", "value"], "properties": { "type": { "const": "setCounter" }, "counter": { "$ref": "#/$defs/id" }, "value": { "type": "number", "minimum": -1000000, "maximum": 1000000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "counter", "amount"], "properties": { "type": { "const": "addCounter" }, "counter": { "$ref": "#/$defs/id" }, "amount": { "type": "number", "minimum": -1000000, "maximum": 1000000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "showMessage" }, "text": { "type": "string", "minLength": 1, "maxLength": 240 }, "duration": { "type": "number", "minimum": 0.2, "maximum": 12 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "direction"], "properties": { "type": { "const": "setGravity" }, "direction": { "enum": [-1, 1] } } }
      ]
    },
    "actions": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/action" } },
    "itemPackage": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "item"], "properties": { "kind": { "const": "item-definition" }, "schemaVersion": { "const": 1 }, "item": { "type": "object", "additionalProperties": false, "required": ["id", "label", "actions"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "sprite": { "type": "string", "minLength": 3, "maxLength": 160 }, "width": { "type": "number", "minimum": 8, "maximum": 128 }, "height": { "type": "number", "minimum": 8, "maximum": 128 }, "score": { "type": "number", "minimum": -999999, "maximum": 999999 }, "actions": { "$ref": "#/$defs/actions" }, "collectAudio": { "type": "string", "minLength": 3, "maxLength": 160 }, "editor": { "$ref": "#/$defs/editor" } } } } },
    "entity": { "type": "object", "additionalProperties": false, "required": ["id", "label", "base"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "base": { "enum": ["enemy", "boss", "hazard", "decoration"] }, "sprite": { "type": "string", "minLength": 3, "maxLength": 160 }, "width": { "type": "number", "minimum": 8, "maximum": 256 }, "height": { "type": "number", "minimum": 8, "maximum": 256 }, "health": { "type": "number", "minimum": 1, "maximum": 9999 }, "speed": { "type": "number", "minimum": 0, "maximum": 240 }, "patrolRange": { "type": "number", "minimum": 0, "maximum": 2048 }, "damage": { "type": "number", "minimum": 0, "maximum": 100 }, "score": { "type": "number", "minimum": -999999, "maximum": 999999 }, "onDefeat": { "$ref": "#/$defs/actions" }, "editor": { "$ref": "#/$defs/editor" } } },
    "handler": { "type": "object", "additionalProperties": false, "required": ["event", "actions"], "properties": { "id": { "$ref": "#/$defs/id" }, "event": { "enum": ["level.start", "item.collect", "enemy.defeat", "key.collect", "region.enter", "timer.tick"] }, "filter": { "$ref": "#/$defs/filter" }, "once": { "type": "boolean" }, "cooldown": { "type": "number", "minimum": 0, "maximum": 3600 }, "actions": { "$ref": "#/$defs/actions" } } },
    "mechanicPackage": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "mechanic"], "properties": { "kind": { "const": "mechanic-definition" }, "schemaVersion": { "const": 1 }, "mechanic": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "type": "string", "maxLength": 240 }, "counters": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "number", "minimum": -1000000, "maximum": 1000000 } }, "entities": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/entity" } }, "handlers": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/handler" } } } } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "mime", "data"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "sprite" }, "mime": { "const": "image/png" }, "data": { "type": "string", "contentEncoding": "base64", "maxLength": 699060 }, "label": { "type": "string", "maxLength": 80 }, "frames": { "type": "integer", "minimum": 1, "maximum": 128 }, "frameWidth": { "type": "integer", "minimum": 1, "maximum": 2048 }, "frameHeight": { "type": "integer", "minimum": 1, "maximum": 2048 } } },
    "assetPackage": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "assets"], "properties": { "kind": { "const": "asset-pack" }, "schemaVersion": { "const": 1 }, "assets": { "type": "array", "maxItems": 96, "items": { "$ref": "#/$defs/asset" } } } },
    "assetDescriptorPackage": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "assets"], "properties": { "kind": { "const": "asset-descriptors" }, "schemaVersion": { "const": 1 }, "assets": { "type": "array", "maxItems": 96, "items": { "type": "object", "additionalProperties": false, "required": ["id", "source"], "properties": { "id": { "$ref": "#/$defs/id" }, "source": { "type": "string", "pattern": "^builtin:procedural/[a-z0-9._-]+$" }, "tint": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" }, "label": { "type": "string", "maxLength": 80 } } } } } },
    "track": { "type": "object", "additionalProperties": false, "required": ["id", "mime", "data"], "properties": { "id": { "$ref": "#/$defs/id" }, "mime": { "enum": ["audio/wav", "audio/ogg", "audio/mpeg"] }, "data": { "type": "string", "contentEncoding": "base64", "maxLength": 2796212 }, "label": { "type": "string", "maxLength": 80 }, "category": { "enum": ["music", "player", "enemy", "level"] }, "loop": { "type": "boolean" }, "gain": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "musicPackage": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "tracks"], "properties": { "kind": { "const": "music-pack" }, "schemaVersion": { "const": 1 }, "tracks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/track" } }, "notice": { "type": "string", "maxLength": 240 } } },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["title"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 80 }, "author": { "type": "string", "maxLength": 80 }, "description": { "type": "string", "maxLength": 400 }, "key": { "$ref": "#/$defs/id" } } },
    "mapPackage": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "metadata", "map"], "properties": { "kind": { "enum": ["map-course", "map-fragment"] }, "schemaVersion": { "const": 1 }, "metadata": { "$ref": "#/$defs/metadata" }, "map": { "type": "object", "required": ["type", "width", "height", "tilewidth", "tileheight", "layers"], "properties": { "type": { "const": "map" }, "width": { "type": "integer", "minimum": 1, "maximum": 1024 }, "height": { "type": "integer", "minimum": 1, "maximum": 64 }, "tilewidth": { "type": "integer", "minimum": 1, "maximum": 128 }, "tileheight": { "type": "integer", "minimum": 1, "maximum": 128 }, "layers": { "type": "array", "maxItems": 64 } } } } },
    "componentLibrary": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "components"], "properties": { "kind": { "const": "component-library" }, "schemaVersion": { "const": 1 }, "components": { "type": "object", "maxProperties": 128 } } }
  }
}
